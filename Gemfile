source "https://rubygems.org"

# Match GitHub Pages' managed build environment, rather than building the theme
# locally with its retired npm/webpack pipeline.
gem "github-pages", "= 232", group: :jekyll_plugins
gem "jekyll-include-cache", "~> 0.2"

# Required by `jekyll serve` on Ruby 3.
gem "webrick", "~> 1.9"
